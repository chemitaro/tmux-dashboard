#!/usr/bin/env bash
set -euo pipefail

die() {
  echo "tmux-dashboard: $*" >&2
  exit 1
}

show_help() {
  cat <<'EOF'
tmux-dashboard

Usage:
  tmux-dashboard [--config PATH]
  tmux-dashboard -h | --help

Wrapper options:
  --config PATH   Pass this config path to the internal runner.
  -h, --help      Show this help.

Wrapper behavior:
  - Ensures the tmux session "dashboard" exists
  - Ensures the visible dashboard window exists
  - Validates the local virtualenv before touching tmux state
  - Starts/respawns the internal runner in "__tmux_dashboard_runner__"
  - Switches/attaches the client to the dashboard window

Internal runner:
  - This wrapper launches:
      .venv/bin/python -m tmux_dashboard --window-target dashboard:<index> [--config PATH]
  - Runner options (when running it directly):
      --once
      --iterations N
      --window-target TARGET
      --config PATH

Examples:
  ./tmux-dashboard
  ./tmux-dashboard --config ./configs/default.yaml
  .venv/bin/python -m tmux_dashboard --config ./configs/default.yaml --once --iterations 1 --window-target dashboard:0

Notes:
  - Dependencies are expected to be installed at setup time (via `uv sync --locked`).
  - Runtime does not invoke `uv`; it uses the repo-local `.venv/bin/python` directly.
  - The wrapper only accepts --config and -h/--help.
  - To use runner-only flags like --once/--iterations, run `python -m tmux_dashboard` directly.
EOF
}

CONFIG_PATH=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    --config)
      shift || true
      [[ $# -gt 0 ]] || die "--config requires a path"
      CONFIG_PATH="$1"
      shift || true
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

resolve_script_path() {
  # Resolve symlinks for $1 (macOS-friendly: no readlink -f).
  local script_path="$1"
  if [[ "$script_path" != /* ]]; then
    script_path="$(pwd)/$script_path"
  fi
  while [[ -L "$script_path" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$script_path")" && pwd)"
    local link
    link="$(readlink "$script_path")"
    if [[ "$link" == /* ]]; then
      script_path="$link"
    else
      script_path="$dir/$link"
    fi
  done
  echo "$(cd -P "$(dirname "$script_path")" && pwd)/$(basename "$script_path")"
}

repair_hint() {
  local cache_hint="${REPO_DIR}/.tmp/uv-cache"
  cat >&2 <<EOF
tmux-dashboard: repair steps:
  cd "$REPO_DIR"
  rm -rf .venv
  UV_CACHE_DIR="$cache_hint" uv sync --locked
EOF
}

preflight_runtime() {
  if [[ ! -x "$PYTHON_BIN" ]]; then
    die "virtualenv python not found at: $PYTHON_BIN"
  fi

  if ! (cd "$REPO_DIR" && "$PYTHON_BIN" -c 'import yaml, libtmux, tmux_dashboard') >/dev/null 2>&1; then
    echo "tmux-dashboard: broken virtualenv: cannot import PyYAML/libtmux/tmux_dashboard" >&2
    repair_hint
    exit 1
  fi
}

runner_meta() {
  local pane_target="$1"
  tmux display-message -p -t "$pane_target" '#{pane_dead}|#{pane_start_command}' 2>/dev/null || true
}

runner_bootstrap_failed() {
  local pane_target="$1"
  local meta
  meta="$(runner_meta "$pane_target")"
  [[ -z "$meta" ]] && return 0

  local pane_dead="${meta%%|*}"
  [[ "$pane_dead" == "1" ]]
}

runner_output_tail() {
  local pane_target="$1"
  tmux capture-pane -p -t "$pane_target" 2>/dev/null | tail -n 40 || true
}

list_session_windows() {
  tmux list-windows -t "$SESSION_NAME" -F "#{window_index}|#{window_name}|#{window_active}"
}

pick_canonical_dashboard_window_index() {
  local rows="$1"
  local idx=""
  idx="$(printf '%s\n' "$rows" | awk -F '|' -v runner="$RUNNER_WINDOW_NAME" '$2=="dashboard" && $2!=runner {print $1; exit}')"
  if [[ -n "$idx" ]]; then
    printf '%s\n' "$idx"
    return 0
  fi

  local active_matches=""
  active_matches="$(printf '%s\n' "$rows" | awk -F '|' -v runner="$RUNNER_WINDOW_NAME" '$2!=runner && $3=="1" {print $1}')"
  if [[ -n "$active_matches" ]] && [[ "$(printf '%s\n' "$active_matches" | wc -l | tr -d ' ')" == "1" ]]; then
    printf '%s\n' "$active_matches"
    return 0
  fi

  printf '%s\n' "$rows" | awk -F '|' -v runner="$RUNNER_WINDOW_NAME" '$2!=runner {print $1; exit}'
}

cleanup_duplicate_dashboard_windows() {
  local canonical_index="$1"
  local rows="$2"
  while IFS='|' read -r idx name _active; do
    [[ -n "$idx" ]] || continue
    if [[ "$name" == "$RUNNER_WINDOW_NAME" ]]; then
      continue
    fi
    if [[ "$idx" == "$canonical_index" ]]; then
      continue
    fi
    tmux kill-window -t "${SESSION_NAME}:${idx}" || die "failed to cleanup duplicate dashboard window: ${SESSION_NAME}:${idx}"
  done <<< "$rows"
}

# Resolve repo root from this script location (works even when invoked via symlink).
SCRIPT_REALPATH="$(resolve_script_path "$0")"
REPO_DIR="${TMUX_DASHBOARD_REPO_DIR:-$(cd "$(dirname "$SCRIPT_REALPATH")" && pwd)}"
PYTHON_BIN="${TMUX_DASHBOARD_PYTHON_BIN:-$REPO_DIR/.venv/bin/python}"
RUNNER_GRACE_SEC="${TMUX_DASHBOARD_RUNNER_GRACE_SEC:-0.2}"
SKIP_ATTACH="${TMUX_DASHBOARD_SKIP_ATTACH:-0}"

command -v tmux >/dev/null 2>&1 || die "tmux not found (tmux 3.2+ recommended)"
[[ -f "$REPO_DIR/pyproject.toml" ]] || die "pyproject.toml not found at: $REPO_DIR"
[[ -d "$REPO_DIR/.venv" ]] || die "virtualenv not found at: $REPO_DIR/.venv"
preflight_runtime

SESSION_NAME="dashboard"
DASHBOARD_WINDOW_NAME="dashboard"
RUNNER_WINDOW_NAME="__tmux_dashboard_runner__"

runner_cmd=("$PYTHON_BIN" -m tmux_dashboard)
if [[ -n "$CONFIG_PATH" ]]; then
  runner_cmd+=(--config "$CONFIG_PATH")
fi
runner_cmd_str="$(printf '%q ' "${runner_cmd[@]}")"
runner_cmd_str="${runner_cmd_str% }"

# Ensure the session exists.
if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  tmux new-session -d -s "$SESSION_NAME" -n "$DASHBOARD_WINDOW_NAME" -c "$REPO_DIR"
fi

# Ensure the visible tiled dashboard window exists and is canonical.
window_rows="$(list_session_windows)"
dashboard_window_index="$(pick_canonical_dashboard_window_index "$window_rows")"
if [[ -z "$dashboard_window_index" ]]; then
  any_window_index="$(
    tmux list-windows -t "$SESSION_NAME" -F "#{window_index}" 2>/dev/null | head -n1
  )"
  [[ -n "$any_window_index" ]] || die "failed to locate an existing window in session: $SESSION_NAME"
  any_window_target="${SESSION_NAME}:${any_window_index}"
  tmux new-window -d -a -t "$any_window_target" -n "$DASHBOARD_WINDOW_NAME" -c "$REPO_DIR"
  window_rows="$(list_session_windows)"
  dashboard_window_index="$(pick_canonical_dashboard_window_index "$window_rows")"
fi
[[ -n "$dashboard_window_index" ]] || die "failed to locate/create dashboard window"
dashboard_window_target="${SESSION_NAME}:${dashboard_window_index}"
tmux rename-window -t "$dashboard_window_target" "$DASHBOARD_WINDOW_NAME"
tmux set-option -w -t "$dashboard_window_target" automatic-rename off
window_rows="$(list_session_windows)"
cleanup_duplicate_dashboard_windows "$dashboard_window_index" "$window_rows"

# Keep dashboard window size policy aligned with active client size.
tmux set-option -w -t "$dashboard_window_target" window-size latest

runner_cmd+=(--window-target "$dashboard_window_target")
runner_cmd_str="$(printf '%q ' "${runner_cmd[@]}")"
runner_cmd_str="${runner_cmd_str% }"
runner_shell_cmd="/bin/bash -lc $(printf '%q' "exec $runner_cmd_str")"

# Locate/create the runner window.
runner_window_index="$(
  tmux list-windows -t "$SESSION_NAME" -F "#{window_index}|#{window_name}" \
    | awk -F '|' -v name="$RUNNER_WINDOW_NAME" '$2==name{print $1; exit}'
)"
if [[ -z "$runner_window_index" ]]; then
  tmux new-window -d -a -t "$dashboard_window_target" -n "$RUNNER_WINDOW_NAME" -c "$REPO_DIR"
  runner_window_index="$(
    tmux list-windows -t "$SESSION_NAME" -F "#{window_index}|#{window_name}" \
      | awk -F '|' -v name="$RUNNER_WINDOW_NAME" '$2==name{print $1; exit}'
  )"
fi
[[ -n "$runner_window_index" ]] || die "failed to create runner window"
runner_window_target="${SESSION_NAME}:${runner_window_index}"
tmux set-option -w -t "$runner_window_target" automatic-rename off
tmux set-option -w -t "$runner_window_target" remain-on-exit on

# If the runner pane isn't running tmux_dashboard, respawn it.
runner_pane_target="${SESSION_NAME}:${runner_window_index}.0"
runner_state="$(runner_meta "$runner_pane_target")"
runner_start_command="${runner_state#*|}"
runner_dead="${runner_state%%|*}"
if [[ "$runner_dead" == "1" || "$runner_start_command" != *"tmux_dashboard"* ]]; then
  tmux respawn-pane -k -t "$runner_pane_target" -c "$REPO_DIR" "$runner_shell_cmd"
fi
sleep "$RUNNER_GRACE_SEC"

if runner_bootstrap_failed "$runner_pane_target"; then
  echo "tmux-dashboard: runner bootstrap failed before attach" >&2
  capture_tail="$(runner_output_tail "$runner_pane_target")"
  if [[ -n "$capture_tail" ]]; then
    echo "tmux-dashboard: runner pane output (tail)" >&2
    echo "$capture_tail" >&2
  fi
  exit 1
fi

# Display the dashboard window.
if [[ "$SKIP_ATTACH" == "1" ]]; then
  exit 0
fi

if [[ -n "${TMUX-}" ]]; then
  tmux switch-client -t "$dashboard_window_target"
else
  exec tmux attach -t "$dashboard_window_target"
fi
